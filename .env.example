# 阿里云百炼平台配置（推荐）
ALIYUN_API_KEY=your_aliyun_api_key_here
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_MODEL=qwen-plus

# DeepSeek API 配置（备选）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API 配置（备选）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# LLM 提供商选择：aliyun 或 deepseek 或 openai
LLM_PROVIDER=aliyun

# Embedding 模型配置（用于向量检索和分类）
# 支持 text-embedding-v1~v4 模型
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ChromaDB 持久化目录
CHROMA_PERSIST_DIR=./chroma_data

# 情感分析模型（用户自选：任意 HuggingFace 文本分类模型均可，
# 需输出 positive/negative(/neutral) 标签；留空时走关键词回退方案。
# 示例为多语言三分类模型，中英文统一处理，无需语言分流）
SENTIMENT_MODEL_NAME=lxyuan/distilbert-base-multilingual-cased-sentiments-student
# SENTIMENT_FALLBACK_ENABLED:
#   - True: 先尝试加载模型，失败后回退到关键词方案
#   - False: 直接使用关键词方案，跳过模型加载（快速启动，默认）
SENTIMENT_FALLBACK_ENABLED=True

# Hugging Face 镜像源（清华镜像，用于国内下载）
HF_ENDPOINT=https://hf-mirror.com

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs

# 默认用户 ID
DEFAULT_USER_ID=default_user

# LangGraph 检查点持久化（面试会话跨进程重启恢复）
CHECKPOINT_DB_PATH=./checkpoints.db

# MCP 工具服务（自建 Tool Server，stdio 协议）
# MCP_ENABLED: 是否优先走 MCP Tool Server（失败自动降级本地实现）
# MCP_STDIO_SERVER_CMD: MCP Server 启动命令（客户端按需自动拉起）
MCP_ENABLED=true
MCP_STDIO_SERVER_CMD=python -m companion_ai.tools.mcp_server